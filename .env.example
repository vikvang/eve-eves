# Vercel Connect connector UID for GitHub. Create with `vercel connect create`
# and paste the UID. Required for the github extension (draft PRs) and station
# sandbox clones of FACTORY_REPO.
GITHUB_CONNECTOR=github/foreman-agent

# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and the GitHub App behind GITHUB_CONNECTOR must be
# installed with access to it: deployment clones this repository to prewarm
# the station sandboxes and fails with "Cannot access <owner/repo>" when the
# app cannot reach it. A missing or malformed value fails discovery with a
# clear error. For the retro game factory this is the games monorepo.
FACTORY_REPO=acme/retro-games

# Optional: runs inside the station sandboxes' clone once per template build,
# so sessions start with dependencies installed and the repo's checks runnable.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_BRANCH_PREFIX="factory/"   # branch prefix for factory/game-<slug>
# FACTORY_BOT_NAME=""                # commit identity; defaults to the GitHub App's slug via the connector
