{
  "name": "eve-software-factory-template",
  "version": "0.0.0",
  "private": true,
  "description": "Foreman, the eve retro game factory.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "build:games": "tsx scripts/games/build-all.ts",
    "check": "ultracite check",
    "dev": "eve dev",
    "eval": "eve eval",
    "fix": "ultracite fix",
    "new-game": "tsx scripts/games/new-game.ts",
    "playtest": "tsx games/_playtest/src/cli.ts",
    "start": "eve start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p games/_kit/tsconfig.json --noEmit && tsc -p games/_template/tsconfig.json --noEmit && tsc -p games/_playtest/tsconfig.json --noEmit",
    "validate": "pnpm run check && pnpm run typecheck && eve info"
  },
  "dependencies": {
    "@github-tools/eve-extension": "^0.3.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "0.8.0",
    "ai": "^7.0.70",
    "eve": "^0.39.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.55.0",
    "@types/node": "~24.13.3",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "7.0.2",
    "ultracite": "^7.10.5",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "24.x"
  }
}
